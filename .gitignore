# Unreal generated files; source Config/Content/Plugins remain trackable.
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/.vs/
/.idea/
*.sln
*.suo
*.VC.db
*.VC.opendb

# Local build/test output and temporary files.
/build/
/out/
/TestResults/
*.tmp
*.log

# Local secrets; never store account credentials in the repository.
.env
.env.*
!.env.example

# C++/IDE outputs outside the standard build directory.
*.obj
*.o
*.pch
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
CMakeUserPresets.json
/CMakeFiles/
/CMakeCache.txt
/.vscode/
.DS_Store
Thumbs.db
