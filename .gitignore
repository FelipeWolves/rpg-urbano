# Unreal generated files; source Config/Content/Plugins remain trackable.
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/.vs/
/.idea/
*.sln
*.suo
*.VC.db
*.VC.opendb

# Local build/test output and temporary files.
/build/
/out/
/TestResults/
*.tmp
*.log

# Local secrets; never store account credentials in the repository.
.env
.env.*
!.env.example

# C++/IDE outputs outside the standard build directory.
*.obj
*.o
*.pch
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
CMakeUserPresets.json
/CMakeFiles/
/CMakeCache.txt
/.vscode/
.DS_Store
Thumbs.db

# Generated data if an Unreal experiment is opened directly.
/experiments/unreal/**/Binaries/
/experiments/unreal/**/Intermediate/
/experiments/unreal/**/Saved/
/experiments/unreal/**/DerivedDataCache/
/experiments/unreal/**/.vs/
*.slnx

# User-supplied media stays local until large-asset versioning is selected.
/assets/runtime/
/assets/source/
/assets/sources/

# User-authorized Markdown deliveries are tracked; media stays local.
/entregas/*/recebidos/**
!/entregas/*/recebidos/**/
!/entregas/*/recebidos/**/*.md
